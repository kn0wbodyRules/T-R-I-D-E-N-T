# Copy to .env and fill in. Never commit .env.

# --- Postgres ---
POSTGRES_USER=sih_admin
POSTGRES_PASSWORD=changeme
POSTGRES_DB=oilspill
DATABASE_URL=postgresql+psycopg://sih_admin:changeme@postgres:5432/oilspill

# --- Ollama ---
OLLAMA_HOST=http://ollama:11434
OLLAMA_MODEL=llama3.2:3b

# --- CDSE (Copernicus Data Space Ecosystem) — Sentinel-1 SAR scenes ---
# Your actual CDSE account email/password, not an OAuth client id/secret --
# the bulk-download API authenticates via the password grant against CDSE's
# public client, and a client_credentials OAuth client 401s on it even though
# token issuance succeeds (that flow is scoped to Sentinel Hub/openEO only).
CDSE_USERNAME=
CDSE_PASSWORD=

# --- AISStream.io — live AIS WebSocket ---
AISSTREAM_API_KEY=

# --- AISHub — fallback live AIS feed ---
AISHUB_USERNAME=

# --- CMEMS (Copernicus Marine Service) — ocean currents ---
CMEMS_USERNAME=
CMEMS_PASSWORD=

# --- ECMWF CDS — ERA5 wind reanalysis ---
CDS_API_KEY=

# --- Segmentation model (Stage 3) ---
ML_CHECKPOINT_DIR=/data/ml/checkpoints
ML_TILE_SIZE=256
ML_TILE_OVERLAP=32

# --- App ---
APP_ENV=development
LOG_LEVEL=info
